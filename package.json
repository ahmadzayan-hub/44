{
  "name": "project-44-railmind-agent-os",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Open-source evidence-first RailMind Agent Operating System for rail asset and contract intelligence",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "build:web-data": "node --experimental-strip-types scripts/build-web-data.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:web": "node --check web/app.js && node --check web/data/demo-pack.js",
    "check:web-data": "node --experimental-strip-types scripts/check-web-data.mjs",
    "check:portfolio": "node scripts/check-portfolio.mjs",
    "check:package": "npm run build && node scripts/package-smoke.mjs",
    "verify": "npm run typecheck && npm run check:web && npm run check:web-data && npm run check:portfolio && npm test && npm run check:package",
    "serve": "node server.mjs",
    "start": "node server.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
